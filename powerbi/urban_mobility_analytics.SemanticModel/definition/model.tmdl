model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["marts daily_mobility_summary","marts dim_date","marts dim_hour","marts dim_payment_type","marts dim_rate_code","marts dim_store_and_fwd","marts dim_vendor","marts fact_trip","marts hourly_demand_profile"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'marts daily_mobility_summary'
ref table 'marts dim_date'
ref table 'marts dim_hour'
ref table 'marts dim_payment_type'
ref table 'marts dim_rate_code'
ref table 'marts dim_store_and_fwd'
ref table 'marts dim_vendor'
ref table 'marts fact_trip'
ref table 'marts hourly_demand_profile'
ref table 'Quality Conditions'

ref cultureInfo en-US

